# The Unity project is rooted at /CatMouse Game Project.
/CatMouse Game Project/.utmp/
/CatMouse Game Project/[Ll]ibrary/
/CatMouse Game Project/[Tt]emp/
/CatMouse Game Project/[Oo]bj/
/CatMouse Game Project/[Bb]uild/
/CatMouse Game Project/[Bb]uilds/
/CatMouse Game Project/[Ll]ogs/
/CatMouse Game Project/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/CatMouse Game Project/[Mm]emoryCaptures/

# Recordings can get excessive in size
/CatMouse Game Project/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /CatMouse Game Project/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/CatMouse Game Project/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Keep the repo-level Visual Studio workload manifest; ignore per-user IDE state.
!.vsconfig
/CatMouse Game Project/.vsconfig

# Local JetBrains and VS Code state. Keep only reusable workspace settings.
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Graphify outputs are derived from the working tree and can be regenerated locally.
/graphify-out/
/.graphify_*.json

# Packed Addressables
/CatMouse Game Project/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/CatMouse Game Project/[Aa]ssets/[Ss]treamingAssets/aa.meta
/CatMouse Game Project/[Aa]ssets/[Ss]treamingAssets/aa/*

# Local visual-validation captures are reproducible from the development scene.
/CatMouse Game Project/Assets/_Project/Art/Validation/

# Local Unity validation captures stay outside the Unity project and are not shared.
/local-screenshots/

# Do not keep Graphify output or IDE solution files inside the Unity project.
/CatMouse Game Project/graphify-out/
*.slnx
